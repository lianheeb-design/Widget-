# Copy to `.env.local` and fill in (Supabase dashboard → Project Settings → API).
# Both values are public by design: the dashboard signs in with Supabase Auth,
# and the database lets only admins (table licensing.admins) see or change
# anything. NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
