// English — the reference locale. Every other file in this folder should have
// the same keys; anything missing falls back to the text here.
//
// - The file name is the language's BCP 47 code (`pt-BR.json5`, `es.json5`…).
// - Nested objects become dotted keys: `settings.general` → t("settings.general").
// - `{name}` placeholders are filled in by the code; keep them as is.
{
  language: {
    // Shown in the language picker, written in the language itself.
    name: "English",
  },

  // Settings window
  settings: {
    subtitle: "Settings",
    // Sidebar groups
    section: {
      app: "App",
      island: "Island",
    },
    general: "General",
    minimize: "Minimize",
    close: "Close",
    module: {
      label: "Show in the island",
      desc: "Turn off to hide this module completely.",
    },
    autostart: {
      label: "Start with Windows",
      appOnly: "Only available in the app.",
      disabledByUser: "Turned off in Task Manager. Turn it back on there, under Startup apps.",
    },
    language: {
      label: "Language",
      desc: "Defaults to your system language.",
      // {language}: the detected system language's name
      auto: "System ({language})",
    },
    hideInFullscreen: {
      label: "Hide in fullscreen",
      desc: "Hides the island while a game, video or app is fullscreen.",
    },
    expandOnHover: {
      label: "Expand on hover",
      desc: "When off, the island only expands on click.",
    },
    monitor: {
      label: "Monitor",
      desc: "Where the island lives. Automatic follows the primary monitor set in Windows.",
      // {name}: the primary monitor's name
      auto: "Automatic ({name})",
      // {n}: the monitor's number, for monitors without a model name
      generic: "Monitor {n}",
      primary: "primary",
      missing: "Disconnected monitor (using the primary)",
    },
    avoidMaximized: {
      label: "Avoid fullscreen apps",
      desc: "Moves the island to another monitor while a fullscreen app (game, video, presentation) would hide it.",
    },
    returnToCenter: {
      label: "Return to center",
      desc: "Drag the island left or right along the top. When off, it stays where you drop it.",
    },
    returnDelay: {
      label: "Return after",
      desc: "Seconds before a dragged island slides back to the middle.",
    },
    about: {
      title: "About",
      // {version}: the app version, e.g. 1.2.3
      version: "Version {version}",
      source: "Source code",
      license: "License",
      updates: {
        label: "Updates",
        idle: "Check whether a new version is out.",
        checking: "Checking…",
        latest: "You're on the latest version.",
        // {version}: the new version, e.g. 1.2.3
        ready: "Version {version} is ready to install.",
        dev: "Development builds don't update.",
        portable: "The portable version doesn't update itself. Download the new one from GitHub.",
        store: "Updates come from the Microsoft Store.",
        error: "Couldn't check for updates.",
        check: "Check",
        install: "Restart and update",
      },
    },
  },

